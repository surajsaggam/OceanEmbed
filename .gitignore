# ==============================================================================
# OceanEmbed / OceanIQ — Git Ignore Configuration
# ==============================================================================

# ── Data & Datasets (large scientific files, never committed) ─────────────────
/data/
/results/
*.nc
*.nc4
*.grib
*.grb
*.zarr/
*.parquet

# SQLite local runtime stores
*.db
*.sqlite
*.sqlite3

# ── Model Weights & Checkpoints (large binaries) ──────────────────────────────
/checkpoints/
*.pt
*.pth
*.onnx
*.bin
*.h5
*.ckpt
*.safetensors

# ── Python Environment & Virtualenvs ──────────────────────────────────────────
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
develop-eggs/
downloads/
eggs/
.eggs/
*.egg-info/
.installed.cfg
*.egg
.Python

# ── Python Bytecode & Compilation Artifacts ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# ── Build & Distribution ──────────────────────────────────────────────────────
dist/
build/
dashboard/dist/
dashboard/build/

# ── Testing, Coverage & Linters ───────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# ── Node / Frontend Dependencies & Logs ───────────────────────────────────────
node_modules/
dashboard/node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache

# Ensure dashboard source code is NEVER ignored by generic rules
!dashboard/src/**

# ── Jupyter Notebooks ─────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Secrets, Credentials & Environment Config ─────────────────────────────────
.env
*.env
.env.*
!.env.example
.netrc
_netrc
.copernicusmarine/
credentials.json
secrets.yaml
*.key
*.pem

# ── IDEs, Editors & OS Files ──────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ── Temporary & Log Files ─────────────────────────────────────────────────────
*.log
*.tmp
*.bak

# ── Markdown Documentation (Ignore all .md files except root README) ──────────
*.md
**/*.md
!/README.md
!README.md

# ── Explicitly Tracked Exceptions ─────────────────────────────────────────────
# environment/env_verification.json   ← tracked (GPU/CUDA/AMP verification report)
# configs/*.yaml                       ← tracked (experiment configuration)
# mock_data/*.json                     ← tracked (deterministic mock data)
# README.md                            ← tracked (primary repository overview)
